{
    "include": ["src"],
    "compilerOptions": {
        "types": ["node"],
        "strict": true,
        "module": "NodeNext",
        "outDir": "build",
        "rootDir": "src",
        "declaration": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "noUnusedParameters": true,
        "noUncheckedIndexedAccess": true
    }
}